{
  "framework": "vite",
  "buildCommand": "cd ground-station/frontend && npm run build",
  "outputDirectory": "ground-station/frontend/dist",
  "installCommand": "cd ground-station/frontend && npm install",
  "devCommand": "cd ground-station/frontend && npm run dev",
  "routes": [
    { "src": "/(.*)", "dest": "/ground-station/frontend/dist/$1" }
  ]
}
